OPENAI_API_KEY=
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_ENV=test
JWT_SECRET=
APP_ID=sydney-flight-deals-scanner

# Server-side OAuth configuration.
KEYCLOAK_BASE_URL=
KEYCLOAK_REALM=
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=

# Public client-side OAuth configuration embedded into the Vite build.
# These can match the non-secret KEYCLOAK_* values above.
VITE_KEYCLOAK_BASE_URL=
VITE_KEYCLOAK_REALM=
VITE_KEYCLOAK_CLIENT_ID=

# Optional local admin login bypass.
LOCAL_LOGIN_EMAIL=
LOCAL_LOGIN_PASSWORD=
