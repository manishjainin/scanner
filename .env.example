# ── Database ──────────────────────────────────────────────────────────────────
# For local Laragon dev: set DATABASE_URL directly
DATABASE_URL=mysql://root:@127.0.0.1:3306/flight_deals

# For Docker (docker-compose.yml uses these to build DATABASE_URL automatically)
DB_NAME=flight_deals
DB_USER=flightapp
DB_PASSWORD=changeme
DB_ROOT_PASSWORD=changeme_root

# ── API keys ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_ENV=test

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=
APP_ID=sydney-flight-deals-scanner

# Optional local admin login (bypasses Keycloak)
LOCAL_LOGIN_EMAIL=
LOCAL_LOGIN_PASSWORD=

# ── Keycloak OAuth (optional) ─────────────────────────────────────────────────
KEYCLOAK_BASE_URL=
KEYCLOAK_REALM=
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=

VITE_KEYCLOAK_BASE_URL=
VITE_KEYCLOAK_REALM=
VITE_KEYCLOAK_CLIENT_ID=

# ── Notifications (optional) ──────────────────────────────────────────────────
OWNER_OPEN_ID=

# ── Server port (default 3000) ────────────────────────────────────────────────
PORT=3000
